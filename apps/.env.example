APP_NAME=mamias
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=https://localhost:7443
# Version shown in the panel chip. Read through config/filament-app-version.php,
# so it survives config:cache. Leave empty to fall back to VERSION / git SHA.
APP_VERSION=1.0.0

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ── Service connections ────────────────────────────────────────────────────
# Only read when artisan/tests run on the host. In the containers,
# docker-compose.yml's `environment:` block supplies DB_HOST=db / REDIS_HOST=redis
# and wins, because Laravel's dotenv never overwrites an existing env var.
# Keep these on 127.0.0.1 + the host-published ports.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5433
DB_DATABASE=mamias_db
DB_USERNAME=admin_mamias
DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6380

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mail
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="no-reply@localhost"
MAIL_FROM_NAME="mamias"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Backup & Docker
DOCKER_DB_CONTAINER=mamias_db
DOCKER_BACKUP_CONTAINER=mamias_db_backup

HONEYPOT_ENABLED=true
HONEYPOT_NAME=my_name
HONEYPOT_RANDOMIZE=true
HONEYPOT_VALID_FROM_TIMESTAMP=true
HONEYPOT_VALID_FROM=valid_from
HONEYPOT_SECONDS=1

# Developer Logins (local only — IP-whitelisted)
DEV_LOGINS_ALLOWED_IPS=127.0.0.1
DEV_LOGIN_ADMIN_EMAIL=admin@example.local
DEV_LOGIN_ADMIN_PASSWORD=dev-password-change-me
DEV_LOGIN_SCIENTIST_EMAIL=scientist@example.local
DEV_LOGIN_SCIENTIST_PASSWORD=dev-password-change-me
DEV_LOGIN_PUBLIC_EMAIL=user@example.local
DEV_LOGIN_PUBLIC_PASSWORD=dev-password-change-me

# ── Cap CAPTCHA ────────────────────────────────────────────────────────
CAP_ADMIN_KEY=
CAP_SITE_KEY=
CAP_SECRET_KEY=
# Root-relative on purpose — Caddy proxies /cap/* to the cap container, so the
# widget hits the app's own origin under any hostname. Do not make this absolute.
CAP_PUBLIC_URL=/cap
CAP_INTERNAL_URL=http://cap:3000
