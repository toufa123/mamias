<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <server name="APP_ENV" value="testing"/>
        <env name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <!--
            Tests run against the dedicated PostgreSQL database "mamias_test" (NOT sqlite —
            the app relies on PostGIS types that sqlite cannot express).

            The dev container exports a real DB_DATABASE=mamias_db env var, which lands in
            $_SERVER. Laravel's env reader checks $_SERVER before $_ENV/putenv, so <env> alone
            loses and tests would run against the dev database. Pin the name in $_SERVER too.
            Tests\TestCase::setUpTraits() refuses to run against any database not ending
            in "_test", so a regression here aborts instead of wiping the dev data.

            Host, port and credentials are deliberately NOT overridden: they must follow
            whatever context the suite runs in — db:5432 inside the container, 127.0.0.1:5433
            from the host — and any value hardcoded here is silently ignored anyway, because
            the container's real values already occupy $_SERVER.
        -->
        <server name="DB_DATABASE" value="mamias_test"/>
        <env name="DB_CONNECTION" value="pgsql" force="true"/>
        <env name="DB_DATABASE" value="mamias_test" force="true"/>

        <!--
            Blank the CAPTCHA credentials so CapService::isConfigured() is false and
            verifyToken() takes its local/testing bypass. Otherwise every form-submission
            test fails on a cap_token validation error, and the suite depends on a
            reachable cap container.
        -->
        <env name="CAP_SITE_KEY" value="" force="true"/>
        <env name="CAP_SECRET_KEY" value="" force="true"/>
        <server name="CAP_SITE_KEY" value=""/>
        <server name="CAP_SECRET_KEY" value=""/>

        <!--
            Grant the super_admin role its access via Shield's Gate::before instead of
            explicit permission rows: RefreshDatabase truncates those between tests.
            See the comment in config/filament-shield.php.
        -->
        <env name="SHIELD_SUPER_ADMIN_VIA_GATE" value="true" force="true"/>
        <server name="SHIELD_SUPER_ADMIN_VIA_GATE" value="true"/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
    </php>
</phpunit>
