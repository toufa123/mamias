# Copy this file to .env.production and replace all CHANGE_ME values.
# Do not commit .env.production.

NAME=mamias

# Public app endpoint
# Plesk's nginx terminates TLS and reverse-proxies to the container over
# plain HTTP. APP_URL is still https (that is what browsers hit via Plesk).
SERVER_NAME=app.example.com
APP_URL=https://app.example.com

# Loopback HTTP port the container publishes for Plesk to proxy to.
# In Plesk: Domain → Docker Proxy Rules / Apache & nginx → proxy to
# http://127.0.0.1:${APP_HTTP_PORT}. Not exposed to the public internet.
APP_HTTP_PORT=7080

# Proxies whose X-Forwarded-* headers Laravel should trust.
# '*' is safe here because APP_HTTP_PORT is bound to 127.0.0.1 only, so the
# Plesk proxy is the only possible caller. Set to a specific CIDR/IP list
# (comma-separated) if you bind the port more broadly.
TRUSTED_PROXIES=*

# Laravel runtime
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE

# Optional UID/GID remap (33:33 = www-data)
PUID=33
PGID=33

# Database credentials
DB_DATABASE=mamias_db
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=require

# Redis credentials
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Database image/runtime tuning
POSTGIS_IMAGE=kartoza/postgis:17-3.5
POSTGRES_MULTIPLE_EXTENSIONS=postgis
DEFAULT_ENCODING=UTF8
ALLOW_IP_RANGE=172.16.0.0/12

# Redis image pin
REDIS_IMAGE=redis:7.4-alpine

# App image name/tag for deployment pipelines
APP_IMAGE=mamias-app:prod

# Backup image pin
PG_BACKUP_IMAGE=kartoza/pg-backup:latest

# Mailer (use a real SMTP provider in production)
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=no-reply@app.example.com
MAIL_FROM_NAME=Mamias

# Debug tooling must stay disabled in production
DEBUGBAR_ENABLED=false
DEBUGBAR_STORAGE_ENABLED=false
DEBUGBAR_OPEN_STORAGE=false

