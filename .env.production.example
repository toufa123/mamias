# Copy this file to .env.production and replace all CHANGE_ME values.
# Do not commit .env.production.

NAME=mamias

# Public app endpoint
# Plesk's nginx terminates TLS and reverse-proxies to the container over
# plain HTTP. APP_URL is still https (that is what browsers hit via Plesk).
SERVER_NAME=app.example.com
APP_URL=https://app.example.com

# Loopback HTTP port the container publishes for Plesk to proxy to.
# In Plesk: Domain → Docker Proxy Rules / Apache & nginx → proxy to
# http://127.0.0.1:${APP_HTTP_PORT}. Not exposed to the public internet.
APP_HTTP_PORT=7080

# Non-Plesk hosts only (bare VPS/droplet): the `proxy` service in
# docker-compose.prod.yml terminates TLS itself. Uncomment COMPOSE_PROFILES
# (so `make prod-up` starts it too) and set the public domain (DNS must
# already point here; Let's Encrypt issues the cert on first start).
# Leave both unset under Plesk.
# COMPOSE_PROFILES=standalone
PUBLIC_DOMAIN=

# Proxies whose X-Forwarded-* headers Laravel should trust.
# '*' is safe here because APP_HTTP_PORT is bound to 127.0.0.1 only, so the
# Plesk proxy is the only possible caller. Set to a specific CIDR/IP list
# (comma-separated) if you bind the port more broadly.
TRUSTED_PROXIES=*

# Laravel runtime
APP_ENV=production
APP_DEBUG=false
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE

# Optional UID/GID remap (33:33 = www-data)
PUID=33
PGID=33

# Database credentials
DB_DATABASE=mamias_db
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
DB_SSLMODE=require

# Redis credentials
REDIS_PASSWORD=CHANGE_ME_REDIS_PASSWORD

# Database image/runtime tuning
# PostgreSQL 18 + PostGIS 3.6, the same major version as dev, so dev dumps
# restore here. The tag tracks 18.x patch releases only. Never change the MAJOR
# version on an existing server: each major keeps its data in its own
# /var/lib/postgresql/<major>/main, so a new major silently starts an EMPTY
# cluster beside the old one. Upgrading an existing PostgreSQL 17 server takes
# a dump + restore (see the deployment guide).
POSTGIS_IMAGE=kartoza/postgis:18-3.6
POSTGRES_MULTIPLE_EXTENSIONS=postgis
DEFAULT_ENCODING=UTF8
ALLOW_IP_RANGE=172.16.0.0/12

# Redis image pin
REDIS_IMAGE=redis:7.4-alpine

# App image name/tag for deployment pipelines
APP_IMAGE=mamias-app:prod

# Backup image pin — its pg_dump must match POSTGIS_IMAGE's major version
PG_BACKUP_IMAGE=kartoza/pg-backup:18-3.6

# Mailer — set interactively with `make prod-mail` (also run by prod-env).
# MAIL_SCHEME: smtp = STARTTLS on 587, smtps = TLS on 465.
MAIL_MAILER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_SCHEME=smtp
MAIL_USERNAME=CHANGE_ME_SMTP_USER
MAIL_PASSWORD=CHANGE_ME_SMTP_PASSWORD
MAIL_FROM_ADDRESS=no-reply@app.example.com
MAIL_FROM_NAME=Mamias

# Cap CAPTCHA - set by `make prod-env` / `make prod-keys` on the production
# host: it generates the admin key and has the PRODUCTION Cap server issue
# the site key + secret (development keys do not work there).
# Left empty on purpose: docker-compose.prod.yml refuses to start while any
# is empty (a placeholder text would get through and run in production).
CAP_ADMIN_KEY=
CAP_SITE_KEY=
CAP_SECRET_KEY=
# Cap server version. Must match the cap-widget version in apps/package.json:
# 3.1.x issues "hashwx" keys, which need cap-widget >= 0.1.58.
CAP_IMAGE=tiago2/cap:3.1.14

# Debug tooling must stay disabled in production
DEBUGBAR_ENABLED=false
DEBUGBAR_STORAGE_ENABLED=false
DEBUGBAR_OPEN_STORAGE=false

