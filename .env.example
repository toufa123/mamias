# ── Docker Compose project name (prefixes all container names) ──────
name=mamias

# ── Ports & tuning ─────────────────────────────────────────────────
DB_FORWARD_PORT=54321
POSTGRES_MULTIPLE_EXTENSIONS=postgis
DEFAULT_ENCODING=UTF8
ALLOW_IP_RANGE=all
UID=1000
GID=1000

# ── Runtime Secrets (change these!) ─────────────────────────────────
# DO NOT commit real values. Generate with: php artisan key:generate
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
DB_USERNAME=CHANGE_ME_DB_USER
DB_PASSWORD=CHANGE_ME_DB_PASSWORD

# ── Cap CAPTCHA (proof-of-work spam protection) ─────────────────────
# Set a strong admin key, then log into http://localhost:3000 to
# generate a site key + secret key.
CAP_ADMIN_KEY=Toufa_251205
CAP_SITE_KEY=15a9dcb9a1
CAP_SECRET_KEY=sk-Iqy1EIjDC7mTtMDMsipZZ7i5kaG2Ok3pZ5qlb3Cg
