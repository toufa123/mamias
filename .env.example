# ── Docker Compose project name (prefixes all container names) ──────
name=mamias

# ── Ports & tuning ─────────────────────────────────────────────────
# Keep published ports below 50000: Windows/Hyper-V reserves large blocks of
# the ephemeral range and a container cannot bind a port inside one.
DB_FORWARD_PORT=5433
POSTGRES_MULTIPLE_EXTENSIONS=postgis
DEFAULT_ENCODING=UTF8
ALLOW_IP_RANGE=all
UID=1000
GID=1000

# ── Database images (same names and values as .env.production) ──────
# Keep the PostgreSQL MAJOR (18) equal to production so dumps move both ways.
# The 18-3.6 tags follow 18.x patch releases only. Never change the major on an
# existing volume: each major keeps its data in /var/lib/postgresql/<major>/main,
# so a new major starts an EMPTY cluster beside the old one (dump + restore).
POSTGIS_IMAGE=kartoza/postgis:18-3.6
PG_BACKUP_IMAGE=kartoza/pg-backup:18-3.6
# Cap server: keep in step with cap-widget in apps/package.json (3.1.x issues
# "hashwx" keys, which need cap-widget >= 0.1.58).
CAP_IMAGE=tiago2/cap:3.1.14

# ── Hostname (optional — the stack serves any Host without this) ────
# Caddy answers on every hostname, so you only set these to tune two things:
#   APP_URL           absolute links built without a request (queued mail,
#                     notifications, artisan) — browsing works regardless
#   DEV_SSL_HOSTNAMES names in the self-signed certificate; add any hostname
#                     you browse to, or the browser rejects the cert
# Whatever you pick, add it to your hosts file pointing at 127.0.0.1.
# APP_URL=https://mamias.local:7443
# DEV_SSL_HOSTNAMES=localhost,127.0.0.1,::1,mamias.local,*.mamias.local,dev.mamias.org,host.docker.internal
# MAIL_FROM_ADDRESS=no-reply@mamias.local

# ── New account activation ──────────────────────────────────────────
# false = the user verifies their address from an emailed link (dev mail lands
# in /mamias/mailbox); true = a super_admin verifies them from the Users table.
# Set interactively with `make dev-approval` (also run by dev-env).
AUTH_REGISTRATION_APPROVAL=false

# ── Runtime Secrets (change these!) ─────────────────────────────────
# DO NOT commit real values. Generate with: php artisan key:generate
APP_KEY=base64:CHANGE_ME_GENERATE_WITH_PHP_ARTISAN_KEY_GENERATE
DB_USERNAME=spa_rac_admin
DB_PASSWORD=spa_rac_2026

# ── Cap CAPTCHA (proof-of-work spam protection) ─────────────────────
# Set by `make dev-env` / `make dev-keys`: it generates the admin key and
# has your local Cap server issue the site key + secret. A key only works
# with the Cap server that issued it, so never share or commit them.
# Left empty on purpose: the stack refuses to start while any is empty.
CAP_ADMIN_KEY=
CAP_SITE_KEY=
CAP_SECRET_KEY=
